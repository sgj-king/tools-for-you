# =========================
# New API 生产环境示例环境变量
# 保存路径: /opt/new-api/compose/.env
# 说明:
# 1. 复制本文件为 .env 后再修改占位符
# 2. 所有敏感值都必须替换成高强度随机字符串
# 3. 本文件变量名与 docker-compose.yml、Nginx、脚本保持一致
# =========================

# 基础信息
COMPOSE_PROJECT_NAME=newapi-prod
APP_BASE_DIR=/opt/new-api
APP_DOMAIN=api.example.com
APP_PUBLIC_URL=https://api.example.com
FRONTEND_BASE_URL=https://api.example.com
SERVER_TIMEZONE=Asia/Shanghai

# 仅允许这些管理来源访问后台页面和 /api 管理接口
# 示例是文档保留地址，请替换为你的固定公网出口 IP 或办公网段
ADMIN_ALLOW_CIDR=203.0.113.10/32

# 宿主机路径
NGINX_SITE_PATH=/etc/nginx/sites-available/api.example.com.conf
SYSTEMD_UNIT_PATH=/etc/systemd/system/new-api-stack.service
CERTBOT_WEBROOT=/var/www/certbot

# 固定镜像版本
# 说明:
# - New API 固定到当前 GitHub Releases 最新稳定标签 v0.12.14（2026-04-17）
# - MySQL 与 Redis 也使用固定标签，避免 latest 导致不可控升级
NEW_API_IMAGE=calciumion/new-api:v0.12.14
MYSQL_IMAGE=mysql:8.4.5
REDIS_IMAGE=redis:7.4.2-alpine

# 容器名称
NEW_API_CONTAINER_NAME=new-api
MYSQL_CONTAINER_NAME=new-api-mysql
REDIS_CONTAINER_NAME=new-api-redis

# New API 基础参数
NEW_API_PORT=3000
NODE_NAME=prod-node-1
SESSION_SECRET=<CHANGE_ME_TO_64_PLUS_RANDOM_CHARS>
CRYPTO_SECRET=<CHANGE_ME_TO_64_PLUS_RANDOM_CHARS>
INITIAL_ROOT_TOKEN=<CHANGE_ME_TO_LONG_RANDOM_ROOT_TOKEN>
INITIAL_ROOT_ACCESS_TOKEN=<CHANGE_ME_TO_LONG_RANDOM_ACCESS_TOKEN>

# 注意:
# - TRUSTED_REDIRECT_DOMAINS 用于限制可信跳转域名，减少开放跳转风险
# - TLS_INSECURE_SKIP_VERIFY 正常应为 false，只有你明确知道后果时才改 true
TRUSTED_REDIRECT_DOMAINS=api.example.com
TLS_INSECURE_SKIP_VERIFY=false

# 日志与运行模式
# 说明:
# - ERROR_LOG_ENABLED=false 可减少敏感错误信息暴露到前端
# - 如需排障，可临时改为 true，事后再关闭
ERROR_LOG_ENABLED=false
DEBUG=false
GIN_MODE=release

# Token 和缓存行为
GENERATE_DEFAULT_TOKEN=false
MEMORY_CACHE_ENABLED=true
BATCH_UPDATE_ENABLED=true
BATCH_UPDATE_INTERVAL=5
SYNC_FREQUENCY=60

# 数据库连接池
SQL_MAX_IDLE_CONNS=30
SQL_MAX_OPEN_CONNS=200
SQL_MAX_LIFETIME=300

# Redis 连接池
REDIS_POOL_SIZE=20

# 全局限流
GLOBAL_API_RATE_LIMIT_ENABLE=true
GLOBAL_API_RATE_LIMIT=180
GLOBAL_API_RATE_LIMIT_DURATION=180
GLOBAL_WEB_RATE_LIMIT_ENABLE=true
GLOBAL_WEB_RATE_LIMIT=60
GLOBAL_WEB_RATE_LIMIT_DURATION=180
CRITICAL_RATE_LIMIT_ENABLE=true
CRITICAL_RATE_LIMIT=20
CRITICAL_RATE_LIMIT_DURATION=1200

# 转发超时与大包处理
# 说明:
# - RELAY_TIMEOUT=0 表示不主动截断上游请求，适合避免“上游已扣费、本地先超时”的账单不同步风险
# - STREAMING_TIMEOUT 建议比默认值更宽松，以适配长上下文和思考型模型
RELAY_TIMEOUT=0
STREAMING_TIMEOUT=600
RELAY_MAX_IDLE_CONNS=200
RELAY_MAX_IDLE_CONNS_PER_HOST=100
MAX_REQUEST_BODY_MB=64
STREAM_SCANNER_MAX_BUFFER_MB=128

# 渠道相关后台任务
CHANNEL_UPSTREAM_MODEL_UPDATE_TASK_ENABLED=true
CHANNEL_UPSTREAM_MODEL_UPDATE_TASK_INTERVAL_MINUTES=60
CHANNEL_UPSTREAM_MODEL_UPDATE_MIN_CHECK_INTERVAL_SECONDS=600
CHANNEL_UPDATE_FREQUENCY=1440
CHANNEL_TEST_FREQUENCY=1440

# 请求处理
FORCE_STREAM_OPTION=true
UPDATE_TASK=true
TASK_TIMEOUT_MINUTES=1440
AZURE_DEFAULT_API_VERSION=2025-04-01-preview

# 健康检查使用的逻辑模型名
# 建议在后台创建并映射该模型名，例如 chat-fast
HEALTHCHECK_MODEL_NAME=chat-fast

# MySQL
MYSQL_DATABASE=new_api
MYSQL_USER=newapi
MYSQL_PASSWORD=<CHANGE_ME_TO_STRONG_DB_PASSWORD>
MYSQL_ROOT_PASSWORD=<CHANGE_ME_TO_STRONG_ROOT_PASSWORD>

# Redis
REDIS_PASSWORD=<CHANGE_ME_TO_STRONG_REDIS_PASSWORD>

# 备份
BACKUP_DIR=/opt/new-api/backups
BACKUP_TMP_DIR=/opt/new-api/backups/.tmp
BACKUP_RETENTION_DAYS=14
