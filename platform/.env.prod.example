# =========================================================================
# Commercial AI Platform · 生产环境配置模板
# 保存路径建议: /opt/platform/.env.prod
# 用法:
#   1. cp .env.prod.example .env.prod
#   2. 把所有 REPLACE_WITH_RANDOM_* 用 `openssl rand -hex 32` 替换
#      或直接执行根目录 scripts/gen-prod-secrets.sh 一键生成
#   3. 把 <FILL_ME_*> 占位符替换为真实业务值
#   4. 切勿提交 .env.prod 到 git
# =========================================================================

COMPOSE_PROJECT_NAME=platform-prod

# ----- 宿主机端口（容器仅绑定 127.0.0.1，由 Nginx 反代） -----
GATEWAY_HOST_PORT=8088
AUTH_HOST_PORT=18082
BILLING_HOST_PORT=8082
POLICY_HOST_PORT=8083
RISK_HOST_PORT=8084
RELAY_HOST_PORT=8085
OPS_HOST_PORT=8086
CUSTOMER_CONSOLE_HOST_PORT=3101
ADMIN_CONSOLE_HOST_PORT=3102
PLATFORM_CONSOLE_HOST_PORT=3200
DIGITAL_LIFE_HOST_PORT=8008
NEW_API_HOST_PORT=3005
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
NATS_HOST_PORT=4223
NATS_MONITOR_HOST_PORT=8223
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3006

# ----- 公网 URL（前端拼接 / 跨子域 cookie） -----
CUSTOMER_CONSOLE_PUBLIC_URL=https://app.<FILL_ME_DOMAIN>
ADMIN_CONSOLE_PUBLIC_URL=https://ops.<FILL_ME_DOMAIN>
PLATFORM_CONSOLE_PUBLIC_URL=https://console.<FILL_ME_DOMAIN>
DIGITAL_LIFE_PUBLIC_URL=https://chat.<FILL_ME_DOMAIN>

# ----- 数据库（必改） -----
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_ROOT
PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_PLATFORM_DB
NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi
NEW_API_DB_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_NEWAPI_DB

# ----- Redis / NATS -----
REDIS_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_REDIS
NATS_URL=nats://nats:4222

# ----- New API（必改：会被 new-api 用作签名密钥） -----
NEW_API_IMAGE=calciumion/new-api:v0.12.14
NEW_API_SESSION_SECRET=REPLACE_WITH_RANDOM_HEX_64_NEW_API_SESSION
NEW_API_CRYPTO_SECRET=REPLACE_WITH_RANDOM_HEX_64_NEW_API_CRYPTO
NEW_API_INITIAL_ROOT_TOKEN=REPLACE_WITH_RANDOM_HEX_48_NEW_API_ROOT
NEW_API_INITIAL_ROOT_ACCESS_TOKEN=REPLACE_WITH_RANDOM_HEX_48_NEW_API_ACCESS
NEW_API_INTERNAL_TOKEN=REPLACE_WITH_RANDOM_HEX_48_NEW_API_INTERNAL
NEW_API_ADMIN_USERNAME=<FILL_ME_ADMIN_USERNAME>
NEW_API_ADMIN_PASSWORD=<FILL_ME_STRONG_ADMIN_PASSWORD>
NEW_API_USAGE_MODE=self

# ----- 共享服务参数（必改） -----
SERVICE_BIND_PORT=8080
APP_ENV=production
LOG_LEVEL=info
JWT_SIGNING_KEY=REPLACE_WITH_RANDOM_HEX_64_JWT
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_RANDOM_HEX_48_INTERNAL_TOKEN
PLATFORM_OPS_SHARED_TOKEN=REPLACE_WITH_RANDOM_HEX_48_OPS_SHARED
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=platform-prod

# 生产禁止设置 DEV_DEMO_API_KEY，把它留空让 auth 跳过 demo 注入
DEV_DEMO_API_KEY=

# ----- 服务内部 URL（容器网络） -----
AUTH_BASE_URL=http://auth:8080
BILLING_BASE_URL=http://billing:8080
POLICY_BASE_URL=http://policy:8080
RISK_BASE_URL=http://risk:8080
RELAY_BASE_URL=http://relay:8080
OPS_BASE_URL=http://ops:8080
NEW_API_BASE_URL=http://new-api:3000

# ----- Grafana -----
GRAFANA_ADMIN_USER=<FILL_ME_GRAFANA_USERNAME>
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_HEX_32_GRAFANA

# ----- Platform Console（必改） -----
PLATFORM_CONSOLE_APP_ENV=production
PLATFORM_CONSOLE_ENABLE_MOCK=false
PLATFORM_CONSOLE_ENABLE_PLATFORM_BFF=true
PLATFORM_CONSOLE_PLAYGROUND_MODE=disabled
PLATFORM_CONSOLE_PLAYGROUND_API_KEY=
PLATFORM_SESSION_SECRET=REPLACE_WITH_RANDOM_HEX_64_PLATFORM_SESSION
PLATFORM_CONSOLE_COOKIE_SECURE=true
PLATFORM_CONSOLE_COOKIE_SAMESITE=lax
# 跨子域共享登录态：设为根域（带或不带前导点都可），让 chat./console./app. 共用 cookie
# 单域名部署或本地调试时留空（host-only cookie）
PLATFORM_COOKIE_DOMAIN=.<FILL_ME_DOMAIN>

# ----- Digital Life -----
# 让 Digital_life 通过 platform-gateway 调用大模型，避免绕过计费与风控
# 主路径：PLATFORM_GATEWAY_BASE_URL + PLATFORM_API_KEY，按 cookie.tier 自动选 MODEL_FREE / MODEL_PAID
DIGITAL_LIFE_PLATFORM_GATEWAY_BASE_URL=http://gateway:8080/v1
DIGITAL_LIFE_PLATFORM_API_KEY=<FILL_ME_PLATFORM_API_KEY_FROM_CONSOLE>
DIGITAL_LIFE_MODEL_FREE=chat-basic
DIGITAL_LIFE_MODEL_PAID=chat-pro
# 兜底直连（PLATFORM_GATEWAY_BASE_URL 或 PLATFORM_API_KEY 为空时启用）
DIGITAL_LIFE_OPENCLAW_BASE_URL=http://gateway:8080/v1
DIGITAL_LIFE_OPENCLAW_API_KEY=<FILL_ME_PLATFORM_API_KEY_FROM_CONSOLE>
DIGITAL_LIFE_OPENCLAW_MODEL=chat-pro
DIGITAL_LIFE_TTS_BASE_URL=http://ttsapi.site
DIGITAL_LIFE_FREETTS_BASE_URL=https://freetts.org/api
DIGITAL_LIFE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
DIGITAL_LIFE_ALLOWED_ORIGINS=https://chat.<FILL_ME_DOMAIN>,https://console.<FILL_ME_DOMAIN>
DIGITAL_LIFE_DOCS_ENABLED=0
# 生产关闭调试与详细错误日志（new-api 由 docker-compose 直接置 DEBUG=false / ERROR_LOG_ENABLED=false）

# ----- 上游模型供应商引导 new-api channel -----
# 至少配一个真实提供方的 key；可以重复定义多组 UPSTREAM_* 块实现多渠道
UPSTREAM_OPENAI_API_KEY=<FILL_ME_PROVIDER_KEY>
UPSTREAM_OPENAI_BASE_URL=https://api.groq.com/openai
UPSTREAM_OPENAI_CHANNEL_NAME=groq-primary-prod
UPSTREAM_OPENAI_PUBLIC_MODELS=chat-basic,chat-pro,reasoning-pro,vision-pro
# chat-basic 给免费用户，chat-pro 给付费用户；按你的合约改 mapping
UPSTREAM_OPENAI_MODEL_MAPPING_JSON={"chat-basic":"meta-llama/llama-3.1-8b-instant","chat-pro":"openai/gpt-oss-120b","reasoning-pro":"openai/gpt-oss-120b","vision-pro":"meta-llama/llama-4-scout-17b-16e-instruct"}
UPSTREAM_OPENAI_TEST_MODEL=chat-basic
