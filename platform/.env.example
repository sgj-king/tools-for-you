# =========================
# Commercial AI Platform - Dev Environment
# 保存路径: platform/.env
# =========================

COMPOSE_PROJECT_NAME=platform-dev

# 宿主机端口
GATEWAY_HOST_PORT=8088
AUTH_HOST_PORT=18082
BILLING_HOST_PORT=8082
POLICY_HOST_PORT=8083
RISK_HOST_PORT=8084
RELAY_HOST_PORT=8085
OPS_HOST_PORT=8086
CUSTOMER_CONSOLE_HOST_PORT=3101
ADMIN_CONSOLE_HOST_PORT=3102
PLATFORM_CONSOLE_HOST_PORT=3200
DIGITAL_LIFE_HOST_PORT=8008
CUSTOMER_CONSOLE_PUBLIC_URL=http://127.0.0.1:3101
ADMIN_CONSOLE_PUBLIC_URL=http://127.0.0.1:3102
PLATFORM_CONSOLE_PUBLIC_URL=http://127.0.0.1:3200
DIGITAL_LIFE_PUBLIC_URL=http://127.0.0.1:8008
NEW_API_HOST_PORT=3005
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
NATS_HOST_PORT=4223
NATS_MONITOR_HOST_PORT=8223
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3006

# 数据库
MYSQL_ROOT_PASSWORD=dev_root_password
PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=platform_dev_password
NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi
NEW_API_DB_PASSWORD=newapi_dev_password

# Redis / NATS
REDIS_PASSWORD=redis_dev_password
NATS_URL=nats://nats:4222

# New API
NEW_API_IMAGE=calciumion/new-api:v0.12.14
NEW_API_SESSION_SECRET=<CHANGE_ME_DEV_SESSION_SECRET>
NEW_API_CRYPTO_SECRET=<CHANGE_ME_DEV_CRYPTO_SECRET>
NEW_API_INITIAL_ROOT_TOKEN=dev_new_api_root_token
NEW_API_INITIAL_ROOT_ACCESS_TOKEN=dev_new_api_internal_access_token
NEW_API_INTERNAL_TOKEN=dev_new_api_internal_access_token
NEW_API_ADMIN_USERNAME=devadmin
NEW_API_ADMIN_PASSWORD=DevAdmin123!
NEW_API_USAGE_MODE=self

# Shared service defaults
SERVICE_BIND_PORT=8080
APP_ENV=development
LOG_LEVEL=debug
JWT_SIGNING_KEY=<CHANGE_ME_DEV_JWT_SIGNING_KEY>
INTERNAL_SERVICE_TOKEN=<CHANGE_ME_DEV_INTERNAL_SERVICE_TOKEN>
PLATFORM_OPS_SHARED_TOKEN=<CHANGE_ME_DEV_PLATFORM_OPS_SHARED_TOKEN>
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_BUCKET=platform-dev
DEV_DEMO_API_KEY=demo_live_sk_platform_dev

# Internal URLs
AUTH_BASE_URL=http://auth:8080
BILLING_BASE_URL=http://billing:8080
POLICY_BASE_URL=http://policy:8080
RISK_BASE_URL=http://risk:8080
RELAY_BASE_URL=http://relay:8080
OPS_BASE_URL=http://ops:8080
NEW_API_BASE_URL=http://new-api:3000

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Platform Console
PLATFORM_CONSOLE_APP_ENV=mock
PLATFORM_CONSOLE_ENABLE_MOCK=true
PLATFORM_CONSOLE_ENABLE_PLATFORM_BFF=true
PLATFORM_CONSOLE_PLAYGROUND_MODE=real
PLATFORM_CONSOLE_PLAYGROUND_API_KEY=demo_live_sk_platform_dev
PLATFORM_SESSION_SECRET=<CHANGE_ME_DEV_PLATFORM_SESSION_SECRET>
PLATFORM_CONSOLE_COOKIE_SECURE=false

# Digital Life
DIGITAL_LIFE_OPENCLAW_BASE_URL=http://host.docker.internal:11434/v1
DIGITAL_LIFE_OPENCLAW_API_KEY=openclaw-local
DIGITAL_LIFE_OPENCLAW_MODEL=openclaw
DIGITAL_LIFE_TTS_BASE_URL=http://ttsapi.site
DIGITAL_LIFE_FREETTS_BASE_URL=https://freetts.org/api
DIGITAL_LIFE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# Upstream provider bootstrap for new-api
UPSTREAM_OPENAI_API_KEY=<YOUR_GROQ_OR_OPENAI_COMPATIBLE_API_KEY>
UPSTREAM_OPENAI_BASE_URL=https://api.groq.com/openai
UPSTREAM_OPENAI_CHANNEL_NAME=groq-primary-dev
# 说明：当前示例链路仅配置 chat-pro/reasoning-pro/vision-pro。
# embedding-large 需接入独立 embedding 上游后再启用。
UPSTREAM_OPENAI_PUBLIC_MODELS=chat-pro,reasoning-pro,vision-pro
UPSTREAM_OPENAI_MODEL_MAPPING_JSON={"chat-pro":"openai/gpt-oss-120b","reasoning-pro":"openai/gpt-oss-120b","vision-pro":"meta-llama/llama-4-scout-17b-16e-instruct"}
UPSTREAM_OPENAI_TEST_MODEL=chat-pro
