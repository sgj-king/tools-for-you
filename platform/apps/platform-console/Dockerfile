FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM node:20-alpine AS builder

WORKDIR /app

COPY --from=deps /app/node_modules ./node_modules
COPY . .

ARG NEXT_PUBLIC_APP_ENV=production
ARG NEXT_PUBLIC_ENABLE_MOCK=false
ARG NEXT_PUBLIC_ENABLE_PLATFORM_BFF=true
ARG NEXT_PUBLIC_PLAYGROUND_MODE=real
ARG NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8088
ARG NEXT_PUBLIC_DOCS_URL=http://127.0.0.1:3005
ARG NEXT_PUBLIC_STATUS_URL=http://127.0.0.1:8088/readyz
ARG NEXT_PUBLIC_CUSTOMER_CONSOLE_URL=http://127.0.0.1:3200
ARG NEXT_PUBLIC_ADMIN_CONSOLE_URL=http://127.0.0.1:3200
ARG NEXT_PUBLIC_DIGITAL_LIFE_PUBLIC_URL=http://127.0.0.1:8008
ARG NEXT_PUBLIC_IT_TOOLS_PUBLIC_URL=http://127.0.0.1:3300

ENV NEXT_TELEMETRY_DISABLED=1
ENV NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV
ENV NEXT_PUBLIC_ENABLE_MOCK=$NEXT_PUBLIC_ENABLE_MOCK
ENV NEXT_PUBLIC_ENABLE_PLATFORM_BFF=$NEXT_PUBLIC_ENABLE_PLATFORM_BFF
ENV NEXT_PUBLIC_PLAYGROUND_MODE=$NEXT_PUBLIC_PLAYGROUND_MODE
ENV NEXT_PUBLIC_API_BASE_URL=$NEXT_PUBLIC_API_BASE_URL
ENV NEXT_PUBLIC_DOCS_URL=$NEXT_PUBLIC_DOCS_URL
ENV NEXT_PUBLIC_STATUS_URL=$NEXT_PUBLIC_STATUS_URL
ENV NEXT_PUBLIC_CUSTOMER_CONSOLE_URL=$NEXT_PUBLIC_CUSTOMER_CONSOLE_URL
ENV NEXT_PUBLIC_ADMIN_CONSOLE_URL=$NEXT_PUBLIC_ADMIN_CONSOLE_URL
ENV NEXT_PUBLIC_DIGITAL_LIFE_PUBLIC_URL=$NEXT_PUBLIC_DIGITAL_LIFE_PUBLIC_URL
ENV NEXT_PUBLIC_IT_TOOLS_PUBLIC_URL=$NEXT_PUBLIC_IT_TOOLS_PUBLIC_URL

RUN npm run build

FROM node:20-alpine AS runner

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3200
ENV HOSTNAME=0.0.0.0

WORKDIR /app

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 --ingroup nodejs nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3200

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD wget --spider --quiet http://127.0.0.1:3200/api/healthz || exit 1

CMD ["node", "server.js"]
