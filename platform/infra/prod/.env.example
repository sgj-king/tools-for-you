# =========================
# Commercial AI Platform - Production Template
# Copy to platform/infra/prod/.env and change every CHANGE_ME value.
# =========================

COMPOSE_PROJECT_NAME=platform-prod
APP_ENV=production
LOG_LEVEL=info

# Public domains. Do not use 127.0.0.1 here because these values are used by browsers.
PLATFORM_CONSOLE_PUBLIC_URL=https://console.example.com
DIGITAL_LIFE_PUBLIC_URL=https://app.example.com
PLATFORM_GATEWAY_PUBLIC_URL=https://api.example.com
CUSTOMER_CONSOLE_PUBLIC_URL=https://console.example.com
ADMIN_CONSOLE_PUBLIC_URL=https://console.example.com
NEW_API_PUBLIC_URL=https://new-api.example.com
NEW_API_TRUSTED_REDIRECT_DOMAINS=new-api.example.com,console.example.com

# Host bind ports. Keep these on loopback and expose them through Nginx.
GATEWAY_HOST_PORT=8088
AUTH_HOST_PORT=18082
BILLING_HOST_PORT=8082
POLICY_HOST_PORT=8083
RISK_HOST_PORT=8084
RELAY_HOST_PORT=8085
OPS_HOST_PORT=8086
PLATFORM_CONSOLE_HOST_PORT=3200
DIGITAL_LIFE_HOST_PORT=8008
NEW_API_HOST_PORT=3005
MYSQL_HOST_PORT=3307
REDIS_HOST_PORT=6380
NATS_HOST_PORT=4223
PROMETHEUS_HOST_PORT=9091
GRAFANA_HOST_PORT=3006

# Database
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_MYSQL_ROOT_PASSWORD
PLATFORM_DB_NAME=platform
PLATFORM_DB_USER=platform
PLATFORM_DB_PASSWORD=CHANGE_ME_STRONG_PLATFORM_DB_PASSWORD
NEW_API_DB_NAME=new_api
NEW_API_DB_USER=newapi
NEW_API_DB_PASSWORD=CHANGE_ME_STRONG_NEW_API_DB_PASSWORD

# Redis / NATS
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
NATS_URL=nats://nats:4222

# New API
NEW_API_IMAGE=calciumion/new-api:v0.12.14
NEW_API_SESSION_SECRET=CHANGE_ME_64_HEX
NEW_API_CRYPTO_SECRET=CHANGE_ME_64_HEX
NEW_API_INITIAL_ROOT_TOKEN=CHANGE_ME_NEW_API_ROOT_TOKEN
NEW_API_INITIAL_ROOT_ACCESS_TOKEN=CHANGE_ME_NEW_API_INTERNAL_TOKEN
NEW_API_INTERNAL_TOKEN=CHANGE_ME_NEW_API_INTERNAL_TOKEN
NEW_API_ADMIN_USERNAME=admin
NEW_API_ADMIN_PASSWORD=CHANGE_ME_STRONG_NEW_API_ADMIN_PASSWORD
NEW_API_USAGE_MODE=self

# Shared internal service settings
SERVICE_BIND_PORT=8080
JWT_SIGNING_KEY=CHANGE_ME_64_HEX
INTERNAL_SERVICE_TOKEN=CHANGE_ME_64_HEX
PLATFORM_OPS_SHARED_TOKEN=CHANGE_ME_64_HEX
PLATFORM_SESSION_SECRET=CHANGE_ME_64_HEX
PLATFORM_CONSOLE_COOKIE_SECURE=true
PLATFORM_CONSOLE_COOKIE_SAMESITE=lax

# Internal service URLs
AUTH_BASE_URL=http://auth:8080
BILLING_BASE_URL=http://billing:8080
POLICY_BASE_URL=http://policy:8080
RISK_BASE_URL=http://risk:8080
RELAY_BASE_URL=http://relay:8080
OPS_BASE_URL=http://ops:8080
NEW_API_BASE_URL=http://new-api:3000

# Platform Console
PLATFORM_CONSOLE_APP_ENV=production
PLATFORM_CONSOLE_ENABLE_MOCK=false
PLATFORM_CONSOLE_ENABLE_PLATFORM_BFF=true
PLATFORM_CONSOLE_PLAYGROUND_MODE=real
PLATFORM_CONSOLE_PLAYGROUND_API_KEY=CHANGE_ME_DEMO_OR_DISABLED_API_KEY
PLATFORM_CONSOLE_ALLOWED_ORIGINS=https://console.example.com

# Digital Life
DIGITAL_LIFE_OPENCLAW_BASE_URL=http://host.docker.internal:11434/v1
DIGITAL_LIFE_OPENCLAW_API_KEY=CHANGE_ME_OPENCLAW_OR_PROVIDER_KEY
DIGITAL_LIFE_OPENCLAW_MODEL=openclaw
DIGITAL_LIFE_TTS_BASE_URL=http://ttsapi.site
DIGITAL_LIFE_FREETTS_BASE_URL=https://freetts.org/api
DIGITAL_LIFE_TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural

# Observability
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# Upstream provider bootstrap for new-api
UPSTREAM_OPENAI_API_KEY=CHANGE_ME_PROVIDER_API_KEY
UPSTREAM_OPENAI_BASE_URL=https://api.groq.com/openai
UPSTREAM_OPENAI_CHANNEL_NAME=primary-openai-compatible
UPSTREAM_OPENAI_PUBLIC_MODELS=chat-pro,reasoning-pro,vision-pro
UPSTREAM_OPENAI_MODEL_MAPPING_JSON={"chat-pro":"openai/gpt-oss-120b","reasoning-pro":"openai/gpt-oss-120b","vision-pro":"meta-llama/llama-4-scout-17b-16e-instruct"}
UPSTREAM_OPENAI_TEST_MODEL=chat-pro
