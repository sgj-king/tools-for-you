# LLM 路由
# 优先级：若设置了 PLATFORM_GATEWAY_BASE_URL + PLATFORM_API_KEY，则走 SaaS 网关并按用户分级选模型；
# 否则回退到 OPENCLAW_* 直连（本地 Ollama）。
OPENCLAW_BASE_URL=http://127.0.0.1:11434/v1
OPENCLAW_API_KEY=openclaw-local
OPENCLAW_MODEL=openclaw

# 启用 SaaS 网关分级路由（开发态可填入 dev 演示 key）
PLATFORM_GATEWAY_BASE_URL=
PLATFORM_API_KEY=
MODEL_FREE=chat-basic
MODEL_PAID=chat-pro

TTS_BASE_URL=http://ttsapi.site
FREETTS_BASE_URL=https://freetts.org/api
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
