# =========================================================================
# Digital_life · 生产环境配置模板
# 保存路径建议: /opt/digital-life/.env.prod
# 用法:
#   1. cp .env.prod.example .env.prod
#   2. 把 <FILL_ME_*> 占位符替换为实际值；REPLACE_WITH_RANDOM_* 用
#      `openssl rand -hex 32` 或 `scripts/gen-prod-secrets.sh` 一键生成
#   3. 在容器/进程启动时通过 --env-file .env.prod 注入
# 切勿提交此文件到 git
# =========================================================================

# ----- 运行环境 -----
APP_ENV=production

# 允许跨域的前端来源，多个用逗号分隔；切勿写 *
# 例: https://chat.your-domain.com
ALLOWED_ORIGINS=<FILL_ME_FRONTEND_ORIGIN>

# /docs /redoc /openapi.json 是否对外开放，默认生产关闭
DOCS_ENABLED=0

# ----- 限流（每用户/IP 每个窗口内的最大请求数） -----
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_CHAT_PER_WINDOW=30
RATE_LIMIT_TTS_PER_WINDOW=10
RATE_LIMIT_MEMORY_PER_WINDOW=20

# ----- 公网 URL（供前端拼接跳转） -----
DIGITAL_LIFE_PUBLIC_URL=https://chat.<FILL_ME_DOMAIN>
PLATFORM_GATEWAY_PUBLIC_URL=https://api.<FILL_ME_DOMAIN>
PLATFORM_CONSOLE_PUBLIC_URL=https://console.<FILL_ME_DOMAIN>
NEW_API_PUBLIC_URL=https://admin.<FILL_ME_DOMAIN>

# ----- 内部服务地址（容器网络内可达，不走公网） -----
PLATFORM_GATEWAY_URL=http://gateway:8080
PLATFORM_OPS_URL=http://ops:8080
NEW_API_URL=http://new-api:3000

# ----- 模型上游 -----
# 生产模式：走 SaaS 网关，按 session.user.tier 自动选模型。
# 免费用户 → MODEL_FREE (chat-basic / gpt-4.1-mini)
# 付费用户 → MODEL_PAID (chat-pro / gpt-4.1)
PLATFORM_GATEWAY_BASE_URL=http://gateway:8080/v1
PLATFORM_API_KEY=<FILL_ME_PLATFORM_API_KEY_FROM_CONSOLE>
MODEL_FREE=chat-basic
MODEL_PAID=chat-pro

# 兜底直连（PLATFORM_API_KEY 为空时启用，例如本地 Ollama）
OPENCLAW_BASE_URL=http://gateway:8080/v1
OPENCLAW_API_KEY=<FILL_ME_PLATFORM_API_KEY_FROM_CONSOLE>
OPENCLAW_MODEL=chat-pro

# ----- TTS 服务 -----
TTS_BASE_URL=http://ttsapi.site
FREETTS_BASE_URL=https://freetts.org/api
TTS_DEFAULT_VOICE=zh-CN-XiaoxiaoNeural
TTS_TIMEOUT_SECONDS=45
